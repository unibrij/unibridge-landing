{
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://unibridge-ops.vercel.app/_next/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://unibridge-ops.vercel.app/brand/:path*"
    },
    {
      "source": "/partner",
      "destination": "https://unibridge-ops.vercel.app/partner/login"
    },
    {
      "source": "/partner/login",
      "destination": "https://unibridge-ops.vercel.app/partner/login"
    },
    {
      "source": "/partner/routes",
      "destination": "https://unibridge-ops.vercel.app/partner/routes"
    },
    {
      "source": "/partner/routes/:path*",
      "destination": "https://unibridge-ops.vercel.app/partner/routes/:path*"
    },
    {
      "source": "/surface",
      "destination": "/surface/public/index.html"
    },
    {
      "source": "/surface/:path*",
      "destination": "/surface/public/:path*"
    }
  ]
}
